<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Members Only!</title>
    <link rel="stylesheet" href="/styles.css">
</head>
<body>
    <nav class="nav-bar flex">
        <ul class="flex">
            <li class="hover">Messages</li>
            <li class="hover">Login</li>
            <li class="hover">Sign Up</li>
        </ul>
    </nav>

    <h1>Thanks for your interest in joining the club!</h1>
    <h3>If you have an admin code (default is admin) use it below to gain special admin privileges!</h3>
    
    <form class="sign-up-form" action="/sign-up" method="post">
        <div>
            <h1>* Username</h1>
            <input class="sign-up-input" type="text" name="name" id="name" placeholder="Username" required>
        </div>

        <div>
            <h1>* Password</h1>
            <input class="sign-up-input" type="password" name="password" id="password" placeholder="Password goes here" required>
        </div>

        <div>
            <h1>Admin Code</h1>
            <input class="sign-up-input" type="text" name="admincode" id="admincode" placeholder="To register as admin" value="">
        </div>

        <button class="hover" type="submit">Submit</button>
    </form>


    <footer>
        <p>Thanks for visting Members ONLY!</p>
    </footer>
</body>
</html>